DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel; production uses no Cloudflare
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

# The web goes through the Cloudflare Tunnel; the media hostname is DNS-only and served by the edge proxy in
# fgv-infra-deploy (compose.edge.yaml), whose .env names it SPEXFLIX_MEDIA_HOST
WEB_HOST=spexflix-staging.example.org
MEDIA_HOST=spexflix-media-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexflix-server:develop
WEB_IMAGE=bloomper/fgv-spexflix-web:develop
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.29-alpine

MYSQL_DATABASE=spexflix
MYSQL_USER=spexflix

# CPUs the worker may use while transcoding, and the largest upload the deployment accepts
WORKER_CPUS=2
MAX_UPLOAD_SIZE=50GB

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
# Spexify's GraphQL API on the shared network, for its tracks; empty without Spexify
SPEXIFY_GRAPHQL_URL=http://spexify-api:8080/api/graphql
SPEXIFY_WEB_URL=https://spexify-staging.example.org
SPEXREGISTER_WEB_URL=https://register-staging.example.org
FGV_REVIVAL_WEB_URL=https://revival-staging.example.org
API_IMPORT_SAMPLE_DATA=true
API_SAMPLE_DATA_SIZE=small
API_SAMPLE_DATA_PREPROCESSED=false

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexflix@example.org
FEEDBACK_EMAIL=feedback.spexflix@example.org
UMAMI_WEBSITE_ID=
