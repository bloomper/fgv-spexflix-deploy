DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

# Both hostnames are served by production's reverse proxy; fgv-infra-deploy's .env names the media hostname
# SPEXFLIX_MEDIA_HOST
WEB_HOST=spexflix.example.org
MEDIA_HOST=spexflix-media.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexflix-server:1.0.0
WEB_IMAGE=bloomper/fgv-spexflix-web:1.0.0
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.29-alpine

MYSQL_DATABASE=spexflix
MYSQL_USER=spexflix

# CPUs the worker may use while transcoding, and the largest upload the deployment accepts
WORKER_CPUS=2
MAX_UPLOAD_SIZE=50GB

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
# Spexify's GraphQL API on the shared network, for its tracks; empty without Spexify
SPEXIFY_GRAPHQL_URL=http://spexify-api:8080/api/graphql
SPEXIFY_WEB_URL=https://spexify.example.org
SPEXREGISTER_WEB_URL=https://register.example.org
FGV_REVIVAL_WEB_URL=https://revival.example.org
API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small
API_SAMPLE_DATA_PREPROCESSED=false

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexflix@example.org
FEEDBACK_EMAIL=feedback.spexflix@example.org
UMAMI_WEBSITE_ID=
